APP_ENV=development
DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/dbname

# (Optional) Database URL for running Pytest. If omitted, "_test" is appended to DATABASE_URL.
TEST_DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/dbname_test
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173"]